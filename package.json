{
	"name": "media-tracker",
	"version": "0.1.0",
	"description": "Obsidian plugin to track novels, series, and movies",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm test && npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node scripts/run-tests.mjs",
		"deploy": "bash scripts/deploy.sh",
		"preview:data": "node scripts/preview-data.mjs",
		"preview:build": "node scripts/preview-build.mjs",
		"preview:theme": "node scripts/preview-theme.mjs",
		"preview:screenshot": "node scripts/preview-screenshot.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@electron/asar": "^4.0.1",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"playwright": "^1.57.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"yaml": "2.8.2"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
